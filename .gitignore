# ===== 敏感信息 / 运行时生成（绝不能提交）=====
# 凭据加密密钥（Fernet），泄露可解密已保存的账号 Cookie
backend/data/.secret_key
# SQLite 数据库，内含加密后的平台账号凭据
backend/data/app.db
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3
# 环境变量（可能含密钥）
.env
.env.*
!.env.example

# ===== AI 助手工作记忆（非项目代码）=====
.workbuddy/

# ===== 一键启动脚本（含本机路径，仅本机可用）=====
start.bat

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.so

# ===== Node / 前端 =====
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== 编辑器 / 系统 =====
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
