# 复制为 backend/.env 后按需修改；.env 已被 .gitignore 忽略，切勿提交真实配置
# 所有字段都有默认值，留空即使用 config.py 中的默认行为

# 应用
APP_NAME=灵搜 · LingoSeek
APP_VERSION=0.1.0
DEBUG=true

# 数据库（默认 backend/data/app.db，内含加密后的平台账号凭据）
# DATABASE_URL=sqlite:///./data/app.db

# 允许的跨域来源，多个用 JSON 数组表示
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 凭据加密密钥（Fernet）。留空则自动生成并持久化到 backend/data/.secret_key
# 团队协作时为避免各自密钥不同导致凭据无法解密，可统一设置一个
# SECRET_KEY=

# 请求平台的伪装 UA
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 ...

# 超时与抓取参数
HTTP_TIMEOUT=15.0
SEARCH_PAGE_SIZE=30
QRCODE_TTL=180
