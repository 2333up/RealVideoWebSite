# 复制为 backend/.env 后按需修改；.env 已被 .gitignore 忽略，切勿提交真实配置
# 所有字段都有默认值，留空即使用 config.py 中的默认行为

# 应用
APP_NAME=灵搜 · LingoSeek
APP_VERSION=0.1.0
DEBUG=true

# 数据库（默认 backend/data/app.db，内含加密后的平台账号凭据）
# DATABASE_URL=sqlite:///./data/app.db

# 允许的跨域来源，多个用 JSON 数组表示
# CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 凭据加密密钥（Fernet）。留空则自动生成并持久化到 backend/data/.secret_key
# 团队协作时为避免各自密钥不同导致凭据无法解密，可统一设置一个
# SECRET_KEY=

# 请求平台的伪装 UA
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 ...

# 超时与抓取参数
HTTP_TIMEOUT=15.0
SEARCH_PAGE_SIZE=30
QRCODE_TTL=180

# ---- YouTube ----
# YouTube 在多数网络环境下无法直连，需要显式指定代理；留空表示直连。
# ⚠️ 不能依赖环境的 HTTP_PROXY/HTTPS_PROXY：那类变量常指向只允许内网白名单的
#    代理，访问 youtube.com 会直接返回 502。适配器一律 trust_env=False，
#    代理只认下面这个字段。
# YOUTUBE_PROXY=http://127.0.0.1:7890

# YouTube 只提供音视频分离的 DASH 流，「带声音的完整视频」必须由 ffmpeg 合并。
# 留空则让 yt-dlp 在 PATH 中查找；找不到时前端的「音视频合并」选项会不可用，
# 只能下载纯视频或纯音频。
# FFMPEG_LOCATION=C:/path/to/ffmpeg.exe
