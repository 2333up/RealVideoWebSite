# ============================================================
# video-mind 密钥配置
#
# 复制本文件为 .env，填入你自己的 Key。
# .env 已被 .gitignore 排除，不会进版本库。
# 也可以在应用的「设置」页面里填写，效果相同。
# ============================================================

# ---------- 大模型（分章节 + 思维导图），任选一家 ----------

# DeepSeek（推荐：中文好、极便宜）
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 弃用，
# 现役模型是 deepseek-v4-flash（快且便宜）与 deepseek-v4-pro（更强更贵）。
# 模型名可在应用「设置」页切换，不必写在这里。
DEEPSEEK_API_KEY=

# 通义千问（阿里百炼，与下方云端 ASR 共用 Key）
DASHSCOPE_API_KEY=

# 豆包（火山方舟）
ARK_API_KEY=

# OpenAI（需海外网络）
OPENAI_API_KEY=

# 自定义 OpenAI 兼容端点（如本地 Ollama / vLLM）
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=

# ---------- 云端 ASR（可选，本地 Whisper 无需任何 Key）----------
# 硅基流动 SenseVoice
SILICONFLOW_API_KEY=

# ---------- HuggingFace 模型下载加速 ----------
# 国内网络拉取 Whisper 模型慢或失败时启用镜像，并关闭新版 Xet 通道
# （Xet 与镜像不兼容，会报 401）
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1
